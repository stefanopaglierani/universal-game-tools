# Normalize line endings
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.exr binary
*.hdr binary
*.glb binary
*.fbx binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.pdf binary
